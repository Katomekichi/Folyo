# Encrypts each artist's own SMTP password at rest (Settings > Email).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Losing/rotating this key
# invalidates every artist's already-saved SMTP password.
EMAIL_ENCRYPTION_KEY=""
