generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  createdAt      DateTime        @default(now())
  bookings       Booking[]
  bookingRequests BookingRequest[]
  publicSlug     String?         @unique
}

enum PaymentStatus {
  pending
  partial
  paid
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName    String
  venue         String
  eventDate     DateTime      @db.Date
  startTime     String
  endTime       String
  totalAmount   Float
  advanceAmount Float         @default(0)
  travelExpense Float         @default(0)
  paymentStatus PaymentStatus @default(pending)
  completed     Boolean       @default(false)
  notes         String?
  teamMembers   TeamMember[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, eventDate])
}

// A supporting/team member assisting on a booking, and their payout for it.
model TeamMember {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  amount    Float
  createdAt DateTime @default(now())

  @@index([bookingId])
}

enum RequestStatus {
  pending
  confirmed
  rejected
}

// A booking submitted by a customer through the creator's public booking-request
// link. Held for the creator to price and confirm before it becomes a real Booking.
model BookingRequest {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          RequestStatus @default(pending)
  clientName      String
  clientContact   String
  clientEmail     String?
  venue           String?
  eventDate       String?
  startTime       String?
  endTime         String?
  totalAmount     Float?
  advanceAmount   Float?
  notes           String?
  createdAt       DateTime      @default(now())
  resultBookingId String?

  @@index([userId, status])
}
