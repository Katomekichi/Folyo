generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  createdAt      DateTime        @default(now())
  bookings       Booking[]
  bookingRequests BookingRequest[]
  publicSlug     String?         @unique

  // Per-artist SMTP account used to send booking-confirmation emails from
  // their own address. smtpPassEnc is encrypted at rest (see lib/crypto.ts).
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPassEnc    String?
  smtpFrom       String?

  razorpaySetting RazorpaySetting?
  payments        Payment[]

  // Static UPI QR payment — an alternative to the Razorpay checkout flow
  // that needs no gateway account. Customers scan the QR (or tap the deep
  // link) and pay the artist's own UPI ID directly; there's no webhook, so
  // the artist must mark the booking paid themselves once they see it land.
  upiVpa         String?
}

// Per-artist Razorpay credentials used to collect payments into their own
// Razorpay account. keySecretEnc and webhookSecretEnc are encrypted at rest
// (see lib/crypto.ts). accountId is the Razorpay linked/connected account id,
// used when routing payments to this user under Razorpay Route.
model RazorpaySetting {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyId             String?
  keySecretEnc      String?
  webhookSecretEnc  String?
  accountId         String?
  enabled           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum PaymentStatus {
  pending
  partial
  paid
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName    String
  venue         String
  eventDate     DateTime      @db.Date
  startTime     String
  endTime       String
  totalAmount   Float
  advanceAmount Float         @default(0)
  travelExpense Float         @default(0)
  paymentStatus PaymentStatus @default(pending)
  completed     Boolean       @default(false)
  notes         String?
  teamMembers   TeamMember[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, eventDate])
}

// A supporting/team member assisting on a booking, and their payout for it.
model TeamMember {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  amount    Float
  createdAt DateTime @default(now())

  @@index([bookingId])
}

enum PaymentGatewayStatus {
  created
  paid
  failed
}

// A Razorpay order/payment created for a customer paying an artist through
// the public booking link. bookingId/bookingRequestId are plain references
// (like BookingRequest.resultBookingId) — not enforced Prisma relations —
// since a payment may exist before a Booking is confirmed.
model Payment {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId         String?
  bookingRequestId  String?
  razorpayOrderId   String               @unique
  razorpayPaymentId String?
  amount            Float
  currency          String               @default("INR")
  status            PaymentGatewayStatus @default(created)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, status])
  @@index([bookingId])
  @@index([bookingRequestId])
}

enum RequestStatus {
  pending
  confirmed
  rejected
}

// A booking submitted by a customer through the creator's public booking-request
// link. Held for the creator to price and confirm before it becomes a real Booking.
model BookingRequest {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          RequestStatus @default(pending)
  clientName      String
  clientContact   String
  clientEmail     String?
  venue           String?
  eventDate       String?
  startTime       String?
  endTime         String?
  totalAmount     Float?
  advanceAmount   Float?
  notes           String?
  createdAt       DateTime      @default(now())
  resultBookingId String?

  @@index([userId, status])
}
